ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Spherical Biconvex Lens Test CAD'), '2;1');
FILE_NAME('spherical_lens.step', '2026-08-12T08:00:00', ('Test Writer'), ('2D Optics Project'), 'OpenCASCADE', '2D Optics Engine', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('core data for optical lens');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard', 'automotive_design', 2000, #1);
#3 = PRODUCT_DEFINITION_CONTEXT('part definition', #1, '');
#4 = PRODUCT('SphericalLens', 'Spherical Lens 50mm R=100mm', '', (#3));
#5 = PRODUCT_DEFINITION_FORMATION('1', '', #4);
#6 = PRODUCT_DEFINITION('design', '', #5, #3);
#10 = DIRECTION('center_axis', (0.0, 0.0, 1.0));
#11 = DIRECTION('ref_axis', (1.0, 0.0, 0.0));
#12 = CARTESIAN_POINT('origin', (0.0, 0.0, 0.0));
#13 = AXIS2_PLACEMENT_3D('placement', #12, #10, #11);
#20 = SPHERICAL_SURFACE('front_surface', #13, 100.0);
#21 = CARTESIAN_POINT('back_origin', (0.0, 0.0, 10.0));
#22 = AXIS2_PLACEMENT_3D('back_placement', #21, #10, #11);
#23 = SPHERICAL_SURFACE('back_surface', #22, -100.0);
#30 = ADVANCED_FACE('', (#31), #20, .T.);
#31 = FACE_BOUND('', #32, .T.);
#32 = VERTEX_LOOP('', #33);
#33 = VERTEX_POINT('', #12);
ENDSEC;
END-ISO-10303-21;
