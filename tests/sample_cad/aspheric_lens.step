ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Aspheric Parabolic Lens Test CAD'), '2;1');
FILE_NAME('aspheric_lens.step', '2026-08-12T08:00:00', ('Test Writer'), ('2D Optics Project'), 'OpenCASCADE', '2D Optics Engine', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('core data for optical asphere');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard', 'automotive_design', 2000, #1);
#3 = PRODUCT_DEFINITION_CONTEXT('part definition', #1, '');
#4 = PRODUCT('AsphericLens', 'Conic Aspheric Lens k=-1.0 R=50mm', '', (#3));
#5 = PRODUCT_DEFINITION_FORMATION('1', '', #4);
#6 = PRODUCT_DEFINITION('design', '', #5, #3);
#10 = DIRECTION('center_axis', (0.0, 0.0, 1.0));
#11 = DIRECTION('ref_axis', (1.0, 0.0, 0.0));
#12 = CARTESIAN_POINT('origin', (0.0, 0.0, 0.0));
#13 = AXIS2_PLACEMENT_3D('placement', #12, #10, #11);
#20 = CONICAL_SURFACE('front_asphere', #13, 50.0, 0.0);
#30 = ADVANCED_FACE('', (#31), #20, .T.);
#31 = FACE_BOUND('', #32, .T.);
#32 = VERTEX_LOOP('', #33);
#33 = VERTEX_POINT('', #12);
ENDSEC;
END-ISO-10303-21;
